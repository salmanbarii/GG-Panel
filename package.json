{
  "name": "jtg-panel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "JTG Panel — self-hosted game server management and container orchestration",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --clear-screen=false server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node build.server.mjs",
    "start": "cross-env NODE_ENV=production node dist/server/server.js",
    "start:updated": "bash scripts/start-with-update.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "createuser": "tsx scripts/createuser.ts"
  },
  "dependencies": {
    "@google/genai": "^0.14.1",
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dockerode": "^5.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "extract-zip": "^2.0.1",
    "framer-motion": "^11.18.0",
    "fs-extra": "^11.2.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.471.0",
    "multer": "^1.4.5-lts.1",
    "pidusage": "^3.0.2",
    "prismarine-nbt": "^2.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^5.2.0",
    "react-router-dom": "^7.1.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "ssh2": "^1.16.0",
    "uuid": "^11.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^6.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.34",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.6",
    "@types/pidusage": "^2.0.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/ssh2": "^1.15.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
