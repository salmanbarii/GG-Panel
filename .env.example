# ── JTG Panel configuration ───────────────────────────────────────────────
# HTTP port for the panel (frontend + API + websocket share this port)
PORT=6767

# Secret used to sign JWTs. CHANGE THIS.
JWT_SECRET=change-me-to-a-long-random-string

# ── Container runtime ─────────────────────────────────────────────────────
ENABLE_DOCKER=true
DOCKER_SOCKET_PATH=/var/run/docker.sock

# docker | local  — runtime used when a server does not specify one
DEFAULT_RUNTIME=docker
# When true, users cannot pick a runtime; DEFAULT_RUNTIME is forced
PANEL_RUNTIME_LOCKED=false

# ── SFTP ──────────────────────────────────────────────────────────────────
# 6868 in production, 6869 in development
SFTP_PORT=6868

# ── Integrations ──────────────────────────────────────────────────────────
GEMINI_API_KEY=
GITHUB_WEBHOOK_SECRET=

# ── Environment ───────────────────────────────────────────────────────────
NODE_ENV=production
